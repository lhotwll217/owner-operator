#!/usr/bin/env bash
# Owner Operator launcher — TypeScript runtime via tsx (pi SDK is the engine).
#   ./oo                       → pi's stock interactive mode, our agent config
#   ./oo "what's ongoing?"     → headless single-turn (prose)
#   ./oo --continue "more"     → resume the most recent oo thread
#   ./oo --session <id> "more" → resume a specific oo thread
#   OO_HOME/pi/settings.json          → configured model
# Works from the repo and when installed on PATH via `npm link` (resolves the symlink).

# Resolve symlinks so DIR is the real repo dir even when run as a linked global bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$D/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Installed dependencies must match the checkout's lockfile. Pulling main updates
# package-lock.json but not node_modules, so every entry point (terminal, widget,
# launchd daemon) silently ran the previously installed Pi. The root postinstall
# stamps the lockfile hash into node_modules; a mismatch reinstalls with `npm ci`,
# serialized by a lock directory because several entry points can start at once.
lockfile_sum() { shasum -a 256 "$DIR/package-lock.json" | cut -d' ' -f1; }
STAMP="$DIR/node_modules/.oo-lockfile-sha256"
if [ "$(cat "$STAMP" 2>/dev/null)" != "$(lockfile_sum)" ]; then
  GUARD="$DIR/.oo-install.lock"
  waited=0
  until mkdir "$GUARD" 2>/dev/null; do
    if [ "$waited" -ge 300 ]; then
      echo "oo: waited 300s for another dependency install; remove $GUARD if none is running" >&2
      exit 1
    fi
    sleep 1; waited=$((waited + 1))
  done
  trap 'rmdir "$GUARD" 2>/dev/null' EXIT INT TERM
  if [ "$(cat "$STAMP" 2>/dev/null)" != "$(lockfile_sum)" ]; then
    echo "oo: package-lock.json changed since the last install; running npm ci" >&2
    (cd "$DIR" && npm ci --no-audit --no-fund >&2) || { echo "oo: npm ci failed" >&2; exit 1; }
  fi
  rmdir "$GUARD"; trap - EXIT INT TERM
fi

if [ "$1" = "-i" ] || [ "$1" = "--interactive" ]; then
  shift
fi

if [ "$#" -gt 0 ]; then
  ENTRY="$DIR/src/cli/oo.ts"
else
  ENTRY="$DIR/src/cli/interactive.ts"
fi

# Prefer the checkout's tsx loader (workspace-hoisted to repo root) through Node's --import, not
# the tsx CLI: the CLI opens an IPC socket under TMPDIR, and beneath a long disposable TMPDIR
# (agent and eval sandboxes) that path overflows the socket limit (listen EINVAL). Fall back to npx.
if [ -f "$DIR/node_modules/tsx/dist/loader.mjs" ]; then
  exec node --import "$DIR/node_modules/tsx/dist/loader.mjs" "$ENTRY" "$@"
else
  exec npx tsx "$ENTRY" "$@"
fi
